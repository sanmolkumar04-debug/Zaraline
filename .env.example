# Database (SQLite for dev; use a postgres URL in production and set provider="postgresql" in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Session signing secret (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-of-32+-chars"

# Public site URL (used in metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cashfree Payments (Dashboard -> Developers -> API Keys). CASHFREE_ENV: sandbox | production
# Leave CASHFREE_APP_ID empty to use the built-in local payment simulator (dev only).
# The webhook signature is checked with the same secret key; webhook URL: <site>/api/webhooks/cashfree
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"

# Twilio Verify for emailed OTPs (Console -> Verify -> Services -> your service -> Email integration with SendGrid).
# Leave empty in dev to get the OTP on screen.
# SendGrid (simplest): API key + a verified sender address. Used when TWILIO_* is empty.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SID=""

# Allow the local payment simulator when NODE_ENV=production (never in real prod)
PAYMENT_SIMULATOR="false"

# Comma separated login emails that can access /admin
ADMIN_EMAILS="admin@example.com"
