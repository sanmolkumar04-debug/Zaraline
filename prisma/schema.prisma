generator client {
  provider = "prisma-client-js"
}

// Postgres (Vercel Postgres / Neon). For local dev, point DATABASE_URL at a local Postgres instance too.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique // login identity (OTP is emailed)
  phone     String?   // contact data only, not used to log in
  name      String?
  createdAt DateTime  @default(now())
  addresses Address[]
  orders    Order[]
  carts     Cart[]
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String    @map("phone") // column keeps its old name; it now holds the email
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  pincode   String
  line1     String // house / flat / building
  line2     String // area / street
  landmark  String?
  city      String
  state     String
  type      String   @default("HOME") // HOME | WORK | OTHER
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Collection {
  id          String              @id // short id used in URL
  slug        String
  name        String
  description String?
  image       String?
  sort        Int                 @default(0)
  inNav       Boolean             @default(false)
  products    ProductCollection[]
}

model Product {
  id          String              @id // short id used in URL
  slug        String
  name        String
  description String
  productType String // "Lehenga Choli", "Saree", ...
  specs       String // JSON [[label, value], ...]
  color       String // filter "Colour/Variant"
  images      String // JSON string[]
  popularity  Int                 @default(0)
  returnDays  Int                 @default(3)
  createdAt   DateTime            @default(now())
  variants    Variant[]
  collections ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model Variant {
  id        String      @id // sku short id used in URL
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  price     Int // rupees
  mrp       Int
  stock     Int         @default(0)
  cartItems CartItem[]
  orderItems OrderItem[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode String?
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  qty       Int

  @@unique([cartId, variantId])
}

model Coupon {
  code        String  @id
  title       String
  description String
  kind        String // PERCENT | FLAT
  value       Int
  maxDiscount Int?
  minAmount   Int     @default(0)
  minQty      Int     @default(1)
  active      Boolean @default(true)
}

model ShippingMethod {
  id       String @id
  name     String
  eta      String
  price    Int
  sort     Int    @default(0)
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         String // PENDING_PAYMENT | CONFIRMED | SHIPPED | DELIVERED | CANCELLED | PAYMENT_FAILED
  paymentMethod  String // ONLINE | COD | PARTIAL
  subtotal       Int
  mrpTotal       Int
  couponCode     String?
  offerDiscount  Int         @default(0) // Buy 2 Get 1 Free
  couponDiscount Int         @default(0)
  paymentDiscount Int        @default(0)
  shippingMethod String
  shippingFee    Int
  total          Int
  payNow         Int // amount collected online (0 for COD)
  payOnDelivery  Int
  address        String // JSON snapshot
  cartHash       String
  idempotencyKey String      @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  payments       Payment[]
  events         OrderEvent[]

  @@index([userId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])
  name      String
  size      String
  image     String
  price     Int
  mrp       Int
  qty       Int
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   @default("cashfree")
  amount            Int // paise
  status            String // CREATED | PAID | FAILED | CANCELLED
  // @map keeps the original column names so `prisma db push` needs no column rename on existing databases.
  gatewayOrderId    String   @unique @map("razorpayOrderId")
  gatewayPaymentId  String?  @unique @map("razorpayPaymentId")
  sessionId         String? // Cashfree payment_session_id for opening checkout
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  text      String
  image     String?
  createdAt DateTime @default(now())
}
